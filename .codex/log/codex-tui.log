+                  </Heading>
+                  <Text color="text.muted">{highlight.description}</Text>
+                </ListItem>
+              ))}
+            </List>
+          </Stack>
+
+          <Stack spacing={6}>
+            <Heading as="h2" size="lg">
+              Frequently asked questions
+            </Heading>
