ey, entry);\n\n  return {\n    limited: false,\n    remaining: limit - 1,\n    reset: entry.expiresAt,\n    retryAfter: 0\n  };\n};\n\nexport const clearRateLimit = () => {\n  getStore().clear();\n};\nEOF"],"workdir":"/mnt/g/AI/Code/DCC"}
