+
+const renderWithTheme = (ui: React.ReactNode) => {
+  return render(<ChakraProvider theme={theme}>{ui}</ChakraProvider>);
+};
+
+describe("Hero component", () => {
+  it("renders mission heading with CTA link", () => {
