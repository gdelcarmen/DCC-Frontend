+export async function generateMetadata({ params }: Params): Promise<Metadata> {
+  const post = await getPostBySlug(params.slug);
+  if (!post) {
+    return {
+      title: "Insights & Research | Del Carmen Consulting"
+    };
+  }
+  return buildBlogPostMetadata(post);
+}
